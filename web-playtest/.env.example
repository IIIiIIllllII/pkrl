# Remote playtest collector (server-side only; read by api/playtest.mjs and by
# the Vite dev server's /api/playtest middleware). Never prefix these with VITE_:
# VITE_ variables are compiled into the public browser bundle.
#
# Copy to .env.local for local development. On Vercel, set them under
# Project → Settings → Environment Variables instead.

# https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_…) or legacy service_role JWT. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
