diff --git a/src/battle_ai_rl.c b/src/battle_ai_rl.c
new file mode 100644
index 000000000..23145e49c
--- /dev/null
+++ b/src/battle_ai_rl.c
@@ -0,0 +1,231 @@
+#include "global.h"
+#include "battle.h"
+#include "battle_ai_rl.h"
+#include "data/battle_ai_rl_lut.h"
+#include "constants/battle.h"
+#include "constants/moves.h"
+#include "constants/pokemon.h"
+#include "constants/battle_move_effects.h"
+
+#if !defined(RL_FEATURE_SCHEMA_REVISION) || RL_FEATURE_SCHEMA_REVISION != 101
+#error "Battle AI encoder requires a gen3-lut-v1.1 LUT"
+#endif
+
+static u8 MoveRole(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_PROTECT: case MOVE_DETECT: case MOVE_ENDURE: return 5;
+    case MOVE_RECOVER: case MOVE_SOFT_BOILED: case MOVE_REST: case MOVE_SYNTHESIS:
+    case MOVE_MOONLIGHT: case MOVE_MORNING_SUN: case MOVE_SLACK_OFF: return 4;
+    case MOVE_SUNNY_DAY: case MOVE_RAIN_DANCE: case MOVE_SANDSTORM: case MOVE_HAIL: return 6;
+    case MOVE_SPIKES: return 7;
+    case MOVE_ROAR: case MOVE_WHIRLWIND: return 8;
+    case MOVE_BATON_PASS: return 9;
+    case MOVE_EXPLOSION: case MOVE_SELF_DESTRUCT: case MOVE_MEMENTO: return 10;
+    case MOVE_SEISMIC_TOSS: case MOVE_NIGHT_SHADE: case MOVE_DRAGON_RAGE:
+    case MOVE_SONIC_BOOM: case MOVE_PSYWAVE: case MOVE_SUPER_FANG: return 11;
+    case MOVE_FLAIL: case MOVE_FRUSTRATION: case MOVE_HIDDEN_POWER:
+    case MOVE_LOW_KICK: case MOVE_RETURN: case MOVE_REVERSAL: return 0;
+    }
+    if (gBattleMoves[move].power != 0) return 0;
+    switch (gBattleMoves[move].effect)
+    {
+    case EFFECT_ATTACK_UP: case EFFECT_DEFENSE_UP: case EFFECT_SPEED_UP:
+    case EFFECT_SPECIAL_ATTACK_UP: case EFFECT_SPECIAL_DEFENSE_UP: case EFFECT_ACCURACY_UP:
+    case EFFECT_EVASION_UP: case EFFECT_ATTACK_UP_2: case EFFECT_DEFENSE_UP_2:
+    case EFFECT_SPEED_UP_2: case EFFECT_SPECIAL_ATTACK_UP_2: case EFFECT_SPECIAL_DEFENSE_UP_2:
+    case EFFECT_ACCURACY_UP_2: case EFFECT_EVASION_UP_2: return 2;
+    case EFFECT_ATTACK_DOWN: case EFFECT_DEFENSE_DOWN: case EFFECT_SPEED_DOWN:
+    case EFFECT_SPECIAL_ATTACK_DOWN: case EFFECT_SPECIAL_DEFENSE_DOWN: case EFFECT_ACCURACY_DOWN:
+    case EFFECT_EVASION_DOWN: case EFFECT_ATTACK_DOWN_2: case EFFECT_DEFENSE_DOWN_2:
+    case EFFECT_SPEED_DOWN_2: case EFFECT_SPECIAL_ATTACK_DOWN_2: case EFFECT_SPECIAL_DEFENSE_DOWN_2:
+    case EFFECT_ACCURACY_DOWN_2: case EFFECT_EVASION_DOWN_2: return 3;
+    case EFFECT_SLEEP: case EFFECT_POISON: case EFFECT_TOXIC: case EFFECT_PARALYZE:
+    case EFFECT_WILL_O_WISP: case EFFECT_CONFUSE: return 1;
+    }
+    return 12;
+}
+
+static u8 StatusBucket(u32 status)
+{
+    if (status & STATUS1_BURN) return 1;
+    if (status & STATUS1_PARALYSIS) return 2;
+    if (status & (STATUS1_POISON | STATUS1_TOXIC_POISON)) return 3;
+    if (status & STATUS1_SLEEP) return 4;
+    if (status & STATUS1_FREEZE) return 5;
+    return 0;
+}
+
+static u8 HpBucket(u16 hp, u16 maxHp)
+{
+    if (hp == 0 || maxHp == 0) return 0;
+    if (hp * 4 <= maxHp) return 1;
+    if (hp * 2 <= maxHp) return 2;
+    if (hp * 4 <= maxHp * 3) return 3;
+    return 4;
+}
+
+static u8 TypeSchemaId(u8 type)
+{
+    static const u8 sTypeMap[] = {0, 6, 9, 7, 8, 12, 11, 13, 16, 17, 1, 2, 4, 3, 10, 5, 14, 15};
+    return type < ARRAY_COUNT(sTypeMap) ? sTypeMap[type] : 17;
+}
+
+static u8 TypeEffectBucket(u8 moveType, u8 defender)
+{
+    u16 i, multiplier = 10;
+    u8 type1 = gBattleMons[defender].types[0];
+    u8 type2 = gBattleMons[defender].types[1];
+    for (i = 0; gTypeEffectiveness[i] != TYPE_ENDTABLE; i += 3)
+    {
+        if (gTypeEffectiveness[i] != moveType) continue;
+        if (gTypeEffectiveness[i + 1] == type1)
+            multiplier = multiplier * gTypeEffectiveness[i + 2] / 10;
+        if (type2 != type1 && gTypeEffectiveness[i + 1] == type2)
+            multiplier = multiplier * gTypeEffectiveness[i + 2] / 10;
+    }
+    if (multiplier == 0) return 0;
+    if (multiplier <= 2) return 1;
+    if (multiplier <= 5) return 2;
+    if (multiplier <= 10) return 3;
+    if (multiplier <= 20) return 4;
+    return 5;
+}
+
+static bool8 IsFixedDamageMove(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_COUNTER: case MOVE_DRAGON_RAGE: case MOVE_ENDEAVOR:
+    case MOVE_MIRROR_COAT: case MOVE_NIGHT_SHADE: case MOVE_PSYWAVE:
+    case MOVE_SEISMIC_TOSS: case MOVE_SONIC_BOOM: case MOVE_SUPER_FANG:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 IsVariableDamageMove(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_FLAIL: case MOVE_FRUSTRATION: case MOVE_HIDDEN_POWER:
+    case MOVE_LOW_KICK: case MOVE_RETURN: case MOVE_REVERSAL:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static u8 MoveClass(u16 move)
+{
+    if (IsFixedDamageMove(move)) return 1;
+    if (gBattleMoves[move].power != 0 || IsVariableDamageMove(move)) return 0;
+    return 2;
+}
+
+static u8 HiddenPowerType(u8 battler)
+{
+    u8 bits = ((gBattleMons[battler].hpIV & 1) << 0)
+            | ((gBattleMons[battler].attackIV & 1) << 1)
+            | ((gBattleMons[battler].defenseIV & 1) << 2)
+            | ((gBattleMons[battler].speedIV & 1) << 3)
+            | ((gBattleMons[battler].spAttackIV & 1) << 4)
+            | ((gBattleMons[battler].spDefenseIV & 1) << 5);
+    u8 type = ((NUMBER_OF_MON_TYPES - 3) * bits) / 63 + 1;
+    if (type >= TYPE_MYSTERY) type++;
+    return type;
+}
+
+static u8 HiddenPowerPower(u8 battler)
+{
+    u8 bits = ((gBattleMons[battler].hpIV & 2) >> 1)
+            | ((gBattleMons[battler].attackIV & 2) << 0)
+            | ((gBattleMons[battler].defenseIV & 2) << 1)
+            | ((gBattleMons[battler].speedIV & 2) << 2)
+            | ((gBattleMons[battler].spAttackIV & 2) << 3)
+            | ((gBattleMons[battler].spDefenseIV & 2) << 4);
+    return (40 * bits) / 63 + 30;
+}
+
+static bool8 StatusMoveApplicable(u16 move, u8 moveType, u8 target)
+{
+    u8 type1 = gBattleMons[target].types[0];
+    u8 type2 = gBattleMons[target].types[1];
+    u8 effect = gBattleMoves[move].effect;
+    if ((move == MOVE_THUNDER_WAVE || move == MOVE_GLARE) && TypeEffectBucket(moveType, target) == 0) return FALSE;
+    if ((effect == EFFECT_POISON || effect == EFFECT_TOXIC) &&
+        (type1 == TYPE_POISON || type2 == TYPE_POISON || type1 == TYPE_STEEL || type2 == TYPE_STEEL)) return FALSE;
+    if (effect == EFFECT_WILL_O_WISP && (type1 == TYPE_FIRE || type2 == TYPE_FIRE)) return FALSE;
+    if (move == MOVE_LEECH_SEED && (type1 == TYPE_GRASS || type2 == TYPE_GRASS)) return FALSE;
+    if ((effect == EFFECT_SLEEP || effect == EFFECT_POISON || effect == EFFECT_TOXIC ||
+         effect == EFFECT_PARALYZE || effect == EFFECT_WILL_O_WISP) && gBattleMons[target].status1) return FALSE;
+    if (move == MOVE_NIGHTMARE && !(gBattleMons[target].status1 & STATUS1_SLEEP)) return FALSE;
+    return TRUE;
+}
+
+static u8 EffectivenessFeature(u16 move, u8 moveType, u8 target)
+{
+    u8 moveClass = MoveClass(move);
+    u8 chart = TypeEffectBucket(moveType, target);
+    if (moveClass == 0) return chart;
+    if (moveClass == 1) return chart == 0 ? 0 : 3;
+    return StatusMoveApplicable(move, moveType, target) ? 3 : 0;
+}
+
+bool8 BattleAIRL_IsSupported(void)
+{
+    const u32 excluded = BATTLE_TYPE_DOUBLE | BATTLE_TYPE_LINK | BATTLE_TYPE_SAFARI
+        | BATTLE_TYPE_ROAMER | BATTLE_TYPE_FIRST_BATTLE | BATTLE_TYPE_BATTLE_TOWER
+        | BATTLE_TYPE_FRONTIER | BATTLE_TYPE_EREADER_TRAINER | BATTLE_TYPE_SECRET_BASE
+        | BATTLE_TYPE_INGAME_PARTNER | BATTLE_TYPE_RECORDED_LINK;
+    return (gBattleTypeFlags & BATTLE_TYPE_TRAINER) && !(gBattleTypeFlags & excluded);
+}
+
+void BattleAIRL_ApplyMoveScores(s8 moveScores[MAX_MON_MOVES], bool8 augment)
+{
+    u8 slot;
+    u8 target = BATTLE_OPPOSITE(gActiveBattler);
+    u8 features[MAX_MON_MOVES][RL_FEATURE_COUNT] = {0};
+    s16 scores[MAX_MON_MOVES];
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        u16 move = gBattleMons[gActiveBattler].moves[slot];
+        const struct BattleMove *data = &gBattleMoves[move];
+        u8 moveType = move == MOVE_HIDDEN_POWER ? HiddenPowerType(gActiveBattler) : data->type;
+        u8 power = move == MOVE_HIDDEN_POWER ? HiddenPowerPower(gActiveBattler) : data->power;
+        u8 accuracy = data->accuracy;
+        u8 pp = gBattleMons[gActiveBattler].pp[slot];
+        features[slot][RL_FEATURE_ACTION_SLOT] = slot;
+        features[slot][RL_FEATURE_MOVE_ROLE] = MoveRole(move);
+        features[slot][RL_FEATURE_MOVE_TYPE] = TypeSchemaId(moveType);
+        features[slot][RL_FEATURE_DAMAGE_CLASS] = MoveClass(move) == 2 ? 2 : moveType <= TYPE_STEEL ? 0 : 1;
+        features[slot][RL_FEATURE_POWER_BUCKET] = power == 0 ? 0 : power <= 40 ? 1 : power <= 70 ? 2 : power <= 100 ? 3 : 4;
+        features[slot][RL_FEATURE_ACCURACY_BUCKET] = accuracy == 0 ? 0 : accuracy <= 70 ? 1 : accuracy <= 85 ? 2 : accuracy < 100 ? 3 : 4;
+        features[slot][RL_FEATURE_PRIORITY_BUCKET] = data->priority < 0 ? 0 : data->priority > 0 ? 2 : 1;
+        features[slot][RL_FEATURE_STAB] = moveType == gBattleMons[gActiveBattler].types[0] || moveType == gBattleMons[gActiveBattler].types[1];
+        features[slot][RL_FEATURE_EFFECTIVENESS] = EffectivenessFeature(move, moveType, target);
+        features[slot][RL_FEATURE_PP_BUCKET] = pp == 0 ? 0 : pp <= 4 ? 1 : pp <= 9 ? 2 : pp <= 19 ? 3 : 4;
+        features[slot][RL_FEATURE_USER_HP] = HpBucket(gBattleMons[gActiveBattler].hp, gBattleMons[gActiveBattler].maxHP);
+        features[slot][RL_FEATURE_TARGET_HP] = HpBucket(gBattleMons[target].hp, gBattleMons[target].maxHP);
+        features[slot][RL_FEATURE_USER_STATUS] = StatusBucket(gBattleMons[gActiveBattler].status1);
+        features[slot][RL_FEATURE_TARGET_STATUS] = StatusBucket(gBattleMons[target].status1);
+        features[slot][RL_FEATURE_SPEED_RELATION] = gBattleMons[gActiveBattler].speed < gBattleMons[target].speed ? 0 : gBattleMons[gActiveBattler].speed == gBattleMons[target].speed ? 1 : 2;
+        features[slot][RL_FEATURE_FIRST_TURN] = gDisableStructs[gActiveBattler].isFirstTurn;
+        features[slot][RL_FEATURE_WEATHER] = (gBattleWeather & B_WEATHER_SUN) ? 1
+            : (gBattleWeather & B_WEATHER_RAIN) ? 2
+            : (gBattleWeather & B_WEATHER_SANDSTORM) ? 3
+            : (gBattleWeather & B_WEATHER_HAIL) ? 4 : 0;
+        features[slot][RL_FEATURE_STAGE_SUMMARY] = 2;
+    }
+    BattleAiRlScore(features, scores);
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        s32 value;
+        if (gBattleMons[gActiveBattler].moves[slot] == MOVE_NONE || moveScores[slot] == 0)
+            continue;
+        value = (augment ? moveScores[slot] : 64) + scores[slot];
+        if (value < 1) value = 1;
+        if (value > 127) value = 127;
+        moveScores[slot] = (s8)value;
+    }
+}
diff --git a/src/data/battle_ai_rl_lut.h b/src/data/battle_ai_rl_lut.h
new file mode 100644
index 000000000..cae79d270
--- /dev/null
+++ b/src/data/battle_ai_rl_lut.h
@@ -0,0 +1,30 @@
+#ifndef GUARD_BATTLE_AI_RL_LUT_H
+#define GUARD_BATTLE_AI_RL_LUT_H
+#include <stdint.h>
+#define RL_FEATURE_SCHEMA "gen3-lut-v1"
+#define RL_FEATURE_SCHEMA_REVISION 100
+#define RL_FEATURE_COUNT 20
+#define RL_LUT_PARAMETERS 349
+#define RL_FEATURE_ACTION_SLOT 0
+#define RL_FEATURE_MOVE_ROLE 1
+#define RL_FEATURE_MOVE_TYPE 2
+#define RL_FEATURE_DAMAGE_CLASS 3
+#define RL_FEATURE_POWER_BUCKET 4
+#define RL_FEATURE_ACCURACY_BUCKET 5
+#define RL_FEATURE_PRIORITY_BUCKET 6
+#define RL_FEATURE_STAB 7
+#define RL_FEATURE_EFFECTIVENESS 8
+#define RL_FEATURE_PP_BUCKET 9
+#define RL_FEATURE_USER_HP 10
+#define RL_FEATURE_TARGET_HP 11
+#define RL_FEATURE_USER_STATUS 12
+#define RL_FEATURE_TARGET_STATUS 13
+#define RL_FEATURE_SPEED_RELATION 14
+#define RL_FEATURE_CAN_KO 15
+#define RL_FEATURE_DAMAGE_FRACTION 16
+#define RL_FEATURE_FIRST_TURN 17
+#define RL_FEATURE_WEATHER 18
+#define RL_FEATURE_STAGE_SUMMARY 19
+extern const int8_t gBattleAiRlLut[RL_LUT_PARAMETERS];
+void BattleAiRlScore(const uint8_t features[4][RL_FEATURE_COUNT], int16_t scores[4]);
+#endif
+
