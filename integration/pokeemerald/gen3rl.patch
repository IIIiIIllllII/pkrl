@@ -0,0 +1,6 @@
+#include "battle_ai_rl_lut.h"
+const int8_t gBattleAiRlLut[RL_LUT_PARAMETERS] = {-55,10,-9,-63,-5,21,-10,-6,12,-48,-3,7,14,-7,-69,36,-32,4,127,17,-18,10,27,-40,-59,9,32,17,57,3,47,-18,46,3,-33,-49,63,-25,-29,-18,35,13,-1,33,33,26,-11,47,-1,-90,25,8,-32,18,43,-36,27,68,65,18,-6,42,8,-22,-66,7,-28,-2,-17,-49,-32,16,-4,15,-16,11,11,64,51,85,-7,-6,-20,18,16,-59,-17,-3,65,-103,-37,25,-19,-10,-3,12,63,43,-28,21,-37,12,11,-2,10,-4,-77,-53,59,26,5,56,-20,2,-26,-46,83,21,-24,14,6,-15,16,-15,7,3,25,39,-15,-34,12,20,-4,16,57,-21,8,-25,-30,-15,3,4,-13,19,-8,-72,-35,35,-66,-2,-57,24,-40,-25,-3,-19,-44,12,8,-64,75,-37,-16,-11,65,-39,-41,-67,-28,36,-90,13,2,4,20,-21,-40,-47,38,-54,33,-12,-18,-28,14,9,-19,-8,-17,-43,-11,-8,-24,10,13,17,7,77,18,-42,17,31,9,-38,10,-14,30,49,-9,19,35,45,-13,-70,-53,-34,39,60,113,-73,-52,-31,-44,-70,16,-11,24,64,20,44,8,-115,1,15,6,74,24,-6,-63,54,101,-54,22,-49,-26,40,-31,35,5,-40,-8,-11,-29,-13,-50,34,-15,52,-23,-35,0,52,-23,24,-46,0,-11,47,-9,15,63,35,-4,33,-45,-20,-5,2,10,-10,-11,-21,15,-77,2,-1,-34,17,-74,-15,6,35,-59,12,-14,21,-80,48,-49,9,-40,-39,17,37,-3,-6,30,22,57,-7,-31,-61,11,7,70,-28,22,34,-10,28,-33,-11,-65,62,1,-29,-8,6,64,-72,-21,18,18,-25,-43,-45,16,-24,27,-4,-22,-32,-24,8,-62,-10,49,-41,-44};
+void BattleAiRlScore(const uint8_t f[4][RL_FEATURE_COUNT], int16_t out[4]) {
+  for (unsigned m=0;m<4;m++) { int32_t s=gBattleAiRlLut[m] + gBattleAiRlLut[4 + f[m][0]] + gBattleAiRlLut[8 + f[m][1]] + gBattleAiRlLut[21 + f[m][2]] + gBattleAiRlLut[39 + f[m][3]] + gBattleAiRlLut[42 + f[m][4]] + gBattleAiRlLut[47 + f[m][5]] + gBattleAiRlLut[52 + f[m][6]] + gBattleAiRlLut[55 + f[m][7]] + gBattleAiRlLut[57 + f[m][8]] + gBattleAiRlLut[63 + f[m][9]] + gBattleAiRlLut[68 + f[m][10]] + gBattleAiRlLut[73 + f[m][11]] + gBattleAiRlLut[78 + f[m][12]] + gBattleAiRlLut[84 + f[m][13]] + gBattleAiRlLut[90 + f[m][14]] + gBattleAiRlLut[93 + f[m][15]] + gBattleAiRlLut[95 + f[m][16]] + gBattleAiRlLut[100 + f[m][17]] + gBattleAiRlLut[102 + f[m][18]] + gBattleAiRlLut[107 + f[m][19]] + gBattleAiRlLut[112 + f[m][8] * 13 + f[m][1]] + gBattleAiRlLut[190 + f[m][10] * 13 + f[m][1]] + gBattleAiRlLut[255 + f[m][11] * 2 + f[m][15]] + gBattleAiRlLut[265 + f[m][14] * 2 + f[m][15]] + gBattleAiRlLut[271 + f[m][13] * 13 + f[m][1]];
+    if(s>32767)s=32767; if(s<-32768)s=-32768; out[m]=(int16_t)s; }
+}
